# Public / frontend-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Used for article classification and TrendCard synthesis. Falls back to OPENROUTER_MODEL if unset.
OPENROUTER_RESEARCH_MODEL=
# Used for final Post generation. Falls back to OPENROUTER_MODEL if unset.
OPENROUTER_CONTENT_MODEL=

# Worker
WORKER_SECRET=
RSS_COLLECTOR_ENABLED=true
RSS_COLLECTOR_INTERVAL_HOURS=6
RSS_COLLECTOR_RUN_ON_START=true
RSS_COLLECTOR_BATCH_DELAY_MS=0
RESEARCH_PIPELINE_FULL=false

# P06: enable only after the P04 correction and P06 migration/manual gates.
CALENDAR_DRAFTING_ENABLED=false

# P07: server-only web search adapter. Both are required; select a Responses
# model compatible with web_search and structured JSON. Writing stays on OpenRouter.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=
