# Public / frontend-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# Five independent roles. Each role requires both a provider and a model; there are no older
# single-model settings any more. Web research includes bounded OpenRouter server web search (Exa),
# or set LLM_WEB_RESEARCH_PROVIDER=openai with OPENAI_API_KEY to use OpenAI directly.
LLM_WEB_RESEARCH_PROVIDER=openrouter
LLM_WEB_RESEARCH_MODEL=anthropic/claude-haiku-5.5
LLM_RSS_CLASSIFIER_PROVIDER=openrouter
LLM_RSS_CLASSIFIER_MODEL=anthropic/claude-haiku-5.5
LLM_PLANNING_PROVIDER=openrouter
LLM_PLANNING_MODEL=anthropic/claude-sonnet-5.5
LLM_CONTENT_PROVIDER=openrouter
LLM_CONTENT_MODEL=anthropic/claude-sonnet-5.5
LLM_REVIEW_PROVIDER=openrouter
LLM_REVIEW_MODEL=anthropic/claude-haiku-5.5

# Optional: newsletter stages follow planning, content and review unless these pairs are set
# (each needs both provider and model). Leave them out to keep one set of models.
# LLM_NEWSLETTER_PLAN_PROVIDER=openrouter
# LLM_NEWSLETTER_PLAN_MODEL=anthropic/claude-sonnet-5.5
# LLM_NEWSLETTER_WRITE_PROVIDER=openrouter
# LLM_NEWSLETTER_WRITE_MODEL=anthropic/claude-sonnet-5.5
# LLM_NEWSLETTER_QA_PROVIDER=openrouter
# LLM_NEWSLETTER_QA_MODEL=anthropic/claude-sonnet-5.5

# Worker
WORKER_SECRET=
RSS_COLLECTOR_ENABLED=true
RSS_COLLECTOR_INTERVAL_HOURS=6
RSS_COLLECTOR_RUN_ON_START=true
RSS_COLLECTOR_BATCH_DELAY_MS=0
RESEARCH_PIPELINE_FULL=false

# P06: enable only after the P04 correction and P06 migration/manual gates.
CALENDAR_DRAFTING_ENABLED=false

# The older OPENROUTER_MODEL, OPENROUTER_*_MODEL and OPENAI_RESEARCH_MODEL settings, and the
# RSS synthesis pair, no longer do anything and can be deleted. See docs/ai-provider-task-map.md.
# OpenAI Decisions is optional future work; no Decisions calls are implemented.
# P08: set on web + existing worker only after the P08 migration is applied.
# Absent/false keeps new schedules, monitoring and notification UI disabled.
RESEARCH_AUTOMATION_ENABLED=false
