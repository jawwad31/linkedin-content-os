# Public / frontend-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# Six independent roles. Each explicit role requires both provider and model.
# Web research includes bounded OpenRouter server web search (Exa).
LLM_WEB_RESEARCH_PROVIDER=openrouter
LLM_WEB_RESEARCH_MODEL=anthropic/claude-haiku-5.5
LLM_RSS_CLASSIFIER_PROVIDER=openrouter
LLM_RSS_CLASSIFIER_MODEL=anthropic/claude-haiku-5.5
LLM_RSS_SYNTHESIS_PROVIDER=openrouter
LLM_RSS_SYNTHESIS_MODEL=anthropic/claude-haiku-5.5
LLM_PLANNING_PROVIDER=openrouter
LLM_PLANNING_MODEL=anthropic/claude-sonnet-5.5
LLM_CONTENT_PROVIDER=openrouter
LLM_CONTENT_MODEL=anthropic/claude-sonnet-5.5
LLM_REVIEW_PROVIDER=openrouter
LLM_REVIEW_MODEL=anthropic/claude-haiku-5.5

# Worker
WORKER_SECRET=
RSS_COLLECTOR_ENABLED=true
RSS_COLLECTOR_INTERVAL_HOURS=6
RSS_COLLECTOR_RUN_ON_START=true
RSS_COLLECTOR_BATCH_DELAY_MS=0
RESEARCH_PIPELINE_FULL=false

# P06: enable only after the P04 correction and P06 migration/manual gates.
CALENDAR_DRAFTING_ENABLED=false

# Legacy settings are supported only when the corresponding LLM role pair is
# absent. See docs/ai-provider-task-map.md for the Railway migration checklist.
# Direct OpenAI web research can still use OPENAI_API_KEY/OPENAI_RESEARCH_MODEL.
# OpenAI Decisions is optional future work; no Decisions calls are implemented.
# P08: set on web + existing worker only after the P08 migration is applied.
# Absent/false keeps new schedules, monitoring and notification UI disabled.
RESEARCH_AUTOMATION_ENABLED=false
